DATABASE_URL="file:./dev.db"
PORT=4000
API_KEY="cambiame-por-una-clave-larga"

TELEGRAM_BOT_TOKEN="pega_aca_el_token_que_te_da_botfather"
TELEGRAM_CHAT_IDS="pega_aca_tu_id_de_usuario"

# Email por API HTTPS (recomendado en Render free)
BREVO_API_KEY="pega_aca_la_api_key_de_brevo"
EMAIL_REMITENTE="tu_correo_verificado@ejemplo.com"
EMAIL_DESTINOS="destino1@ejemplo.com,destino2@ejemplo.com"

# Fallback por SMTP (puede estar bloqueado en Render free)
EMAIL_USER="tu_correo_de_la_grafica@gmail.com"
EMAIL_PASS="tu_clave_de_aplicacion_de_16_letras"

# Disparador externo: mínimo 24 caracteres
CRON_SECRET="una_cadena_aleatoria_de_al_menos_24_caracteres"
# Solo para desarrollo local: evita duplicar avisos con GitHub Actions
ENABLE_INTERNAL_CRON="false"
